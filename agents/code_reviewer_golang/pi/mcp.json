{
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      },
      "description": "Read Linear task context when enabled",
      "exposure": "codemode",
      "enabled": false
    },
    "gopls": {
      "command": "gopls",
      "args": [
        "mcp"
      ],
      "description": "Go source navigation and diagnostics",
      "exposure": "codemode"
    }
  }
}
