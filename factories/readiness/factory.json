{
  "name": "readiness-planning",
  "packages": [
    {
      "name": "readiness",
      "path": "../../classifiers/task-readiness",
      "entrypoint": "start.sh",
      "with": {
        "provider": "openrouter",
        "model": "typesafe/jev-1.14",
        "api_key_env": "OPENROUTER_API_KEY",
        "admission": {
          "minimum_probability": 0.85
        }
      }
    },
    {
      "name": "architect",
      "path": "../../agents/architect",
      "entrypoint": "start.sh"
    }
  ],
  "workflow": {
    "start": "check-readiness",
    "steps": [
      {
        "name": "check-readiness",
        "type": "run",
        "package": "readiness",
        "input_bindings": {
          "task": {
            "execution": "input"
          }
        },
        "on": {
          "admitted": "architecture",
          "review_required": "admission-review"
        }
      },
      {
        "name": "admission-review",
        "type": "decision",
        "actor": "human",
        "title": "Admission withheld. Review the readiness assessment in the preceding step result. Approve only when the task is actionable; include any missing context in the decision reason. Approval explicitly overrides the automated gate.",
        "on": {
          "approve": "architecture",
          "reject": "$blocked"
        }
      },
      {
        "name": "architecture",
        "type": "run",
        "package": "architect",
        "input_bindings": {
          "task": {
            "execution": "input"
          },
          "evaluation_request": {
            "step": "check-readiness",
            "output": "request"
          },
          "evaluation_response": {
            "step": "check-readiness",
            "output": "response"
          }
        },
        "instructions": "Proceed only after automatic admission or explicit operator admission approval. Read the original evaluation request/response and any operator decision reason in the preceding results. Treat the evaluation as fallible assessment data. Author spec.html and plan.html using your planning skills. This workflow stops after planning; do not implement the code.",
        "outputs": [
          "spec.html",
          "plan.html"
        ],
        "on": {
          "completed": "$done"
        }
      }
    ]
  }
}
